{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/documents.js": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/documents/:action",
      "destination": "/api/documents?action=:action"
    },
    {
      "source": "/house/:path*",
      "destination": "/api/documents?resource=house/:path*"
    },
    {
      "source": "/plans/:path*",
      "destination": "/api/documents?resource=plans/:path*"
    },
    {
      "source": "/_personal/:path*",
      "destination": "/api/documents?resource=_personal/:path*"
    },
    {
      "source": "/materials/:path*",
      "destination": "/api/documents?resource=materials/:path*"
    }
  ]
}
